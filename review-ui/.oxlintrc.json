{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/*.tsx"],
      "rules": {
        "react/only-export-components": "off",
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
